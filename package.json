{
  "name": "interiorspillet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interiørspillet – gå rundt i stua i 3D og prøv ut interiør før du kjøper (nettleser).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:mobil": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "shot": "node tools/shot.mjs",
    "pack": "vite build && node tools/pack.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
